# Pathway: Neo4j Career Navigator & Skill Gap Agent
# Environment Configuration

# Server Port (defaults to 3001 if 3000 is occupied)
PORT=3001

# Neo4j Graph Database Credentials (AuraDB or self-hosted)
# If left blank, the application automatically runs in Demo Graph Mode with full in-memory graph knowledge!
NEO4J_URI=neo4j+s://your-neo4j-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# Groq AI API Key (Optional: for LLM roadmap explanation & interactive tutoring)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Clerk Authentication (Configured automatically via Clerk CLI)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder

# Optional Integrations
NOTION_API_KEY=secret_placeholder
NOTION_DATABASE_ID=placeholder_id
